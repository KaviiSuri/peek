{
  "manifest_version": 3,
  "name": "Peek",
  "version": "0.1.0",
  "description": "Find and explicitly switch to an open tab by title or URL.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Peek"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "Open Peek"
    }
  }
}
