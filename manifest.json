{
  "manifest_version": 3,
  "name": "Peek",
  "version": "0.2.0",
  "description": "Find and explicitly switch to an open tab by title or URL.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/peek-16.png",
    "32": "icons/peek-32.png",
    "48": "icons/peek-48.png",
    "128": "icons/peek-128.png"
  },
  "action": {
    "default_title": "Open Peek",
    "default_icon": {
      "16": "icons/peek-16.png",
      "32": "icons/peek-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "MacCtrl+Space"
      },
      "description": "Open Peek"
    }
  }
}
