  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@types/node": "^26.5.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
